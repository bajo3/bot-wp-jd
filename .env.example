# Copy to .env.local and fill values

# Meta / WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (if using the extraction step)
OPENAI_API_KEY=

# Optional tuning
# DOLAR_CACHE_MINUTES=120

# Reset the conversation flow if the last bot message is older than this (minutes)
# BOT_RESET_MINUTES=90

# Optional: OpenAI model override
# OPENAI_MODEL=gpt-5.2-mini

# Links / contenido fijo (opcional)
CATALOG_URL=https://jesusdiaz-automotores.vercel.app/catalogo
MAPS_URL=https://maps.app.goo.gl/6hwJZbMRK5oh3Evj9

# Reset the conversation flow if the last bot message is older than this (minutes)
BOT_RESET_MINUTES=30
