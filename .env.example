# Copy to .env.local and fill values

# Meta / WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (if using the extraction step)
OPENAI_API_KEY=

# Optional tuning
# DOLAR_CACHE_MINUTES=120

# Reset the conversation flow if the last bot message is older than this (minutes)
# BOT_RESET_MINUTES=90

# Optional: OpenAI model override
# OPENAI_MODEL=gpt-5.2-mini
# Optional: link to your public catalog (used in handoff messages)
CATALOG_URL=

# Optional: Meta Graph API version override (WhatsApp Cloud)
GRAPH_API_VERSION=v20.0

# Optional: agent rotation cursor (if you run multiple agencies in same DB)
# AGENCY_CURSOR_ID=jesus_diaz
